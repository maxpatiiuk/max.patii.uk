{
  "name": "@maxpatiiuk/static-site-forge",
  "version": "0.0.1",
  "description": "A static site generator for max.patii.uk",
  "private": true,
  "type": "module",
  "exports": {
    "./plugin.js": "./dist/plugin.js",
    "./devTo.js": "./dist/devTo.js",
    "./types.js": {
      "types": "./dist/types.d.ts"
    },
    "./runtime.js": "./dist/runtime.js",
    "./cssLoader.js": "./dist/cssLoader.js",
    "./litHmrPatch.js": "./dist/litHmrPatch.js"
  },
  "scripts": {
    "build": "vite build",
    "build-dev": "vite build --mode development",
    "watch": "node --run build-dev -- --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "prettier": "catalog:"
  },
  "devDependencies": {
    "@arcgis/api-extractor": "catalog:",
    "@lit-labs/ssr": "catalog:",
    "@maxpatiiuk/monorepo-config": "workspace:",
    "@types/node": "catalog:",
    "lit": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@lit-labs/ssr": "catalog:",
    "lit": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "required": false
    }
  }
}
